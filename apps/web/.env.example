# Single-origin web runtime
PORT=3000
BIND_HOST=0.0.0.0
NODE_ENV=development
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database and sessions
MONGO_URI=mongodb://127.0.0.1:27017/curevo
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# Generate a unique random value of at least 32 characters. Never commit the real value.
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Review containment — keep both false until the governance gates are approved.
ALLOW_PRODUCTION_WRITES=false
NEXT_PUBLIC_ALLOW_INDEXING=false
ALLOW_NON_BROWSER_CLIENTS=false

# Request and data retention controls
RATE_LIMIT_MAX=300
ADDITIONAL_CLIENT_ORIGINS=
AUDIT_RETENTION_DAYS=365
FOCUS_DATA_RETENTION_DAYS=730
SUPPORT_RETENTION_DAYS=180
HIBP_PASSWORD_CHECK=false

# Optional email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Curevo <no-reply@example.invalid>
SUPPORT_INBOX=

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Optional Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional blog preview
BLOG_PREVIEW_SECRET=

# Destructive local seed guard. Enable only for the documented one-off task.
RESET_ALL_DATA=false
