{
  "expo": {
    "name": "Curevo",
    "slug": "curevo",
    "scheme": "curevo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "plugins": ["expo-router"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f5f1e8"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}