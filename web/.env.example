# Copy to web/.env.local. Never commit real credentials.
# MongoDB Atlas or a local replica set (required for atomic guest migration).
MONGODB_URI=mongodb://127.0.0.1:27017/curevo?replicaSet=rs0
MONGODB_DB=curevo
MONGODB_TRANSACTIONS=true

# Exact browser origin; set all URLs to your HTTPS domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=
BETTER_AUTH_URL=http://localhost:3000
# Generate locally: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Google Console OAuth web application callback:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated verified Google email addresses allowed to moderate.
ADMIN_EMAILS=

# Optional realtime. API key is server-only. Restrict its capabilities to
# publish + subscribe on the curevo:public channel in your Ably dashboard.
ABLY_API_KEY=

# Recommended distributed limits; durable MongoDB fallback remains active.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set ONLY when your hosting proxy overwrites this header and clients cannot
# access the origin directly. Vercel: x-vercel-forwarded-for. Cloudflare:
# cf-connecting-ip (with origin access locked to Cloudflare).
# Empty safely puts requests in a shared network bucket.
TRUSTED_IP_HEADER=
TRUSTED_PROXY_HOPS=1

# Optional bot check. Once the secret is set, check-ins require a valid token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false
TURNSTILE_ALLOWED_HOSTNAMES=localhost

# Optional approved provider moderation. Without it all public text awaits
# manual moderator approval. Never use fake moderation results in production.
OPENAI_MODERATION_API_KEY=

# Optional anonymous action counts. Only opt-in events are sent, without any
# thought text, emotion, query, account ID, or persistent analytics identifier.
# This mode does not measure per-person funnels or D1/D7/D30 retention.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional errors only. All request bodies, URLs, cookies, breadcrumbs, stack
# messages, account identifiers and private text are scrubbed before sending.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Closed beta: requires invitation before submitting, except allowed admins.
INVITE_ONLY=false
